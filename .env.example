GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_RETRIES=2
AI_RETRY_BASE_MS=800

# OpenAI powers voice only (speech-to-text + text-to-speech). Text generation
# stays on Gemini. Only OPENAI_API_KEY is required; the rest have defaults.
OPENAI_API_KEY=your_openai_key_here

# Must stay whisper-1. Word-level timestamps require response_format=verbose_json
# with timestamp_granularities, which only whisper-1 supports. Pointing this at a
# gpt-4o-* transcribe model still transcribes, but silently drops the timings, so
# pace/pause delivery metrics stop being captured.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Pins the spoken language instead of letting Whisper detect it per clip.
# Auto-detection regularly mis-fires on accented English and returns the turn
# transcribed into Urdu or Hindi script. Any ISO-639-1 code, or "auto" to
# restore detection.
OPENAI_TRANSCRIBE_LANGUAGE=en

OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Fallback only. Each character's voice is pinned per scenario and passed
# explicitly on every call, so this is used only if none was supplied.
OPENAI_TTS_VOICE=alloy

# --- Text-to-speech provider (ElevenLabs pilot) -----------------------------
# Which provider reads scenario messages aloud. "openai" (default) or
# "elevenlabs". Everything else about the voice layer is shared: the same
# scenario casts the same characters and ranks a line's delivery the same way on
# both, so flipping this is a clean A/B rather than two different features.
TTS_PROVIDER=openai

# Required only when TTS_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=

# The pilot target is v3 Conversational -- expressive like v3, but tuned for
# realtime, which is what keeps it inside the 2,500ms hold cap in the simulation
# page. CONFIRM THE EXACT MODEL ID IN THE DOCS before trusting this default;
# "eleven_v3" is the dramatic-performance model and is likely slower.
ELEVENLABS_MODEL=eleven_v3

# 128 kbps is the ceiling on the Starter plan; 192 needs Creator. Worth raising
# only if a blind listening test comes back close enough that audio quality
# needs ruling out as a confound.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Partial JSON map from the pinned OpenAI voice id to an ElevenLabs voice id.
# Merged over the placeholder defaults, so a half-chosen cast can be tried
# without filling in all eleven slots. coral/ballad/verse/nova/shimmer are the
# expressive slots (patient, family member) and must carry distress;
# ash/sage/echo/fable/onyx are the steady slots (nurse, bystander); alloy is the
# narrator and must not sound like any of the others.
#   ELEVENLABS_VOICE_MAP={"coral":"<id>","ballad":"<id>","alloy":"<id>"}
ELEVENLABS_VOICE_MAP=

# Inline audio tags ([whispers], [crying], ...) derived from the per-line stage
# direction. OFF unless set to 1: tags live inside the message text, so a tag the
# model does not support risks being spoken aloud mid-line in front of a trainee.
# Verify the vocabulary against the docs for the model in use before enabling.
ELEVENLABS_AUDIO_TAGS=0

# --- Firebase (accounts, groups, saved runs) --------------------------------
# Optional. Without these the app still runs the full scenario -> simulation ->
# feedback flow against localStorage; only accounts, progress, and the mentor
# dashboard are hidden.
#
# Unlike the keys above, these are PUBLIC identifiers that ship in the client
# bundle by design — that is what the NEXT_PUBLIC_ prefix means. They identify
# the project; they do not authorise anything. Access control lives entirely in
# firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=
