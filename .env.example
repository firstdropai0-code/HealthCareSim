GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_RETRIES=2
AI_RETRY_BASE_MS=800

# OpenAI powers voice only (speech-to-text + text-to-speech). Text generation
# stays on Gemini. Only OPENAI_API_KEY is required; the rest have defaults.
OPENAI_API_KEY=your_openai_key_here

# Must stay whisper-1. Word-level timestamps require response_format=verbose_json
# with timestamp_granularities, which only whisper-1 supports. Pointing this at a
# gpt-4o-* transcribe model still transcribes, but silently drops the timings, so
# pace/pause delivery metrics stop being captured.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Pins the spoken language instead of letting Whisper detect it per clip.
# Auto-detection regularly mis-fires on accented English and returns the turn
# transcribed into Urdu or Hindi script. Any ISO-639-1 code, or "auto" to
# restore detection.
OPENAI_TRANSCRIBE_LANGUAGE=en

OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Fallback only. Each character's voice is pinned per scenario and passed
# explicitly on every call, so this is used only if none was supplied.
OPENAI_TTS_VOICE=alloy

# --- Firebase (accounts, groups, saved runs) --------------------------------
# Optional. Without these the app still runs the full scenario -> simulation ->
# feedback flow against localStorage; only accounts, progress, and the mentor
# dashboard are hidden.
#
# Unlike the keys above, these are PUBLIC identifiers that ship in the client
# bundle by design — that is what the NEXT_PUBLIC_ prefix means. They identify
# the project; they do not authorise anything. Access control lives entirely in
# firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=
